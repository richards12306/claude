# ── 使用 DeepSeek ──────────────────────────────────────────
API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
API_BASE_URL=https://api.deepseek.com
API_MODEL=deepseek-chat

# ── 使用 Anthropic Claude（取消注释，注释掉上面两行）──────
